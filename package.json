{
  "name": "fossibot-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "TZ=Europe/Kyiv vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node tools/station-sim.ts",
    "seed": "node tools/seed-history.ts .dev-data",
    "build:hub": "node scripts/build-hub.mjs",
    "build:web": "vite build --config web/vite.config.ts && node scripts/build-sw.mjs",
    "build": "npm run build:web && npm run build:hub",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:hub": "FOSSIBOT_DATA_DIR=.dev-data FOSSIBOT_STATION_ALLOW=127.0.0. node hub/src/main.ts",
    "ui:check": "npm run build && node scripts/ui-check.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
