#!/data/data/com.termux/files/usr/bin/sh
# Updates fossibot-hub: download a release (latest, a tag, or a local .tar.gz), copy the database,
# switch `current`, restart the service; if the new release is not healthy in 30 s, roll back.
set -eu
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
BASE=${FOSSIBOT_BASE:-$HOME/fossibot-hub}
DATA=${FOSSIBOT_DATA_DIR:-$HOME/.fossibot}
REPO=${FOSSIBOT_REPO:-Enduranc3/fossibot-control}
SV=${FOSSIBOT_SV:-sv}
SVC=$PREFIX/var/service/fossibot-hub
HEALTH=${FOSSIBOT_HEALTH_URL:-http://127.0.0.1:8080/api/health}
WAIT=${FOSSIBOT_START_WAIT:-30}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

src=${1:-latest}
case "$src" in
  *.tar.gz) cp "$src" "$tmp/release.tar.gz" ;;
  latest)
    url=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" |
      grep -o '"browser_download_url": *"[^"]*fossibot-hub-[^"]*\.tar\.gz"' | head -n 1 | sed 's/.*"\(https[^"]*\)"/\1/')
    [ -n "$url" ] || { echo "no release found for $REPO" >&2; exit 1; }
    curl -fsSL "$url" -o "$tmp/release.tar.gz" ;;
  *) curl -fsSL "https://github.com/$REPO/releases/download/$src/fossibot-hub-$src.tar.gz" -o "$tmp/release.tar.gz" ;;
esac

mkdir "$tmp/x"
tar -xzf "$tmp/release.tar.gz" -C "$tmp/x"
ver=$(cat "$tmp/x/VERSION")
prev=$(readlink "$BASE/current" 2>/dev/null || true)
if [ "$prev" = "$BASE/releases/$ver" ]; then
  echo "fossibot-hub $ver is already installed"
  exit 0
fi
mkdir -p "$BASE/releases"
rm -rf "$BASE/releases/$ver"
mv "$tmp/x" "$BASE/releases/$ver"

"$SV" down "$SVC" || true
# The hub closed the database on stop, so the main file alone is a complete copy.
[ -f "$DATA/hub.db" ] && cp "$DATA/hub.db" "$DATA/hub.db.before-$ver"
sh "$BASE/releases/$ver/deploy/termux/install.sh" "$BASE/releases/$ver" >/dev/null
"$SV" up "$SVC"

i=0
while [ "$i" -lt "$WAIT" ]; do
  if curl -fs "$HEALTH" >/dev/null 2>&1; then
    echo "fossibot-hub $ver is running"
    # Keep the three newest releases and database copies.
    ls -1dt "$BASE"/releases/* 2>/dev/null | tail -n +4 | while read -r old; do rm -rf "$old"; done
    ls -1t "$DATA"/hub.db.before-* 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old"; done
    exit 0
  fi
  sleep 1
  i=$((i + 1))
done

echo "fossibot-hub $ver did not start in ${WAIT} s — відкат" >&2
"$SV" down "$SVC" || true
if [ -n "$prev" ]; then
  ln -sfn "$prev" "$BASE/current"
fi
if [ -f "$DATA/hub.db.before-$ver" ]; then
  cp "$DATA/hub.db.before-$ver" "$DATA/hub.db"
  rm -f "$DATA/hub.db-wal" "$DATA/hub.db-shm"
fi
"$SV" up "$SVC"
exit 1
