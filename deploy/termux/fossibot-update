#!/data/data/com.termux/files/usr/bin/sh
# Updates fossibot-hub: download a release (latest, a tag, or a local .tar.gz), stop the hub and wait
# until it is down, copy the database, switch `current`, start it and check that the new version
# answers; if it does not within 30 s — or anything fails on the way — go back to the old release.
set -eu
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
BASE=${FOSSIBOT_BASE:-$HOME/fossibot-hub}
DATA=${FOSSIBOT_DATA_DIR:-$HOME/.fossibot}
REPO=${FOSSIBOT_REPO:-Enduranc3/fossibot-control}
SV=${FOSSIBOT_SV:-sv}
SVC=$PREFIX/var/service/fossibot-hub
HEALTH=${FOSSIBOT_HEALTH_URL:-http://127.0.0.1:8080/api/health}
WAIT=${FOSSIBOT_START_WAIT:-30}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

src=${1:-latest}
case "$src" in
  *.tar.gz) cp "$src" "$tmp/release.tar.gz" ;;
  latest)
    url=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" |
      grep -o '"browser_download_url": *"[^"]*fossibot-hub-[^"]*\.tar\.gz"' | head -n 1 | sed 's/.*"\(https[^"]*\)"/\1/')
    [ -n "$url" ] || { echo "no release found for $REPO" >&2; exit 1; }
    curl -fsSL "$url" -o "$tmp/release.tar.gz" ;;
  *) curl -fsSL "https://github.com/$REPO/releases/download/$src/fossibot-hub-$src.tar.gz" -o "$tmp/release.tar.gz" ;;
esac

mkdir "$tmp/x"
tar -xzf "$tmp/release.tar.gz" -C "$tmp/x"
ver=$(cat "$tmp/x/VERSION")
prev=$(readlink "$BASE/current" 2>/dev/null || true)
if [ "$prev" = "$BASE/releases/$ver" ]; then
  echo "fossibot-hub $ver is already installed"
  exit 0
fi

# One database copy is enough (spec §10); make room for it before the hub is touched.
rm -f "$DATA"/hub.db.before-*
if [ -f "$DATA/hub.db" ]; then
  need=$(du -k "$DATA/hub.db" | cut -f1)
  free=$(df -Pk "$DATA" | awk 'NR == 2 { print $4 }')
  if [ "$free" -lt $((need + 51200)) ]; then
    echo "not enough space for a database copy: need ${need} KB + 50 MB, free ${free} KB" >&2
    exit 1
  fi
fi

mkdir -p "$BASE/releases"
rm -rf "$BASE/releases/$ver"
mv "$tmp/x" "$BASE/releases/$ver"

running_version() {
  curl -fs "$HEALTH" 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}

# runit's `down` returns at once; force-stop waits (and kills on timeout). The health check then
# confirms nothing still holds the database before it is copied or replaced.
stop_hub() {
  "$SV" -w "$WAIT" force-stop "$SVC" >/dev/null 2>&1 || true
  i=0
  while curl -fs "$HEALTH" >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -ge "$WAIT" ] && return 1
    sleep 1
  done
}

wait_for() {
  i=0
  while [ "$i" -lt "$WAIT" ]; do
    [ "$(running_version)" = "$1" ] && return 0
    sleep 1
    i=$((i + 1))
  done
  return 1
}

back_to_previous() {
  [ -n "$prev" ] && ln -sfn "$prev" "$BASE/current"
  "$SV" up "$SVC" || true
}

if ! stop_hub; then
  echo "fossibot-hub did not stop in ${WAIT} s — оновлення перервано, нічого не змінено" >&2
  "$SV" up "$SVC" || true
  exit 1
fi

if ! { { [ ! -f "$DATA/hub.db" ] || cp "$DATA/hub.db" "$DATA/hub.db.before-$ver"; } &&
  sh "$BASE/releases/$ver/deploy/termux/install.sh" "$BASE/releases/$ver" >/dev/null; }; then
  echo "update to $ver failed — оновлення перервано, повертаю попередній реліз" >&2
  back_to_previous
  exit 1
fi

"$SV" up "$SVC"
if wait_for "$ver"; then
  echo "fossibot-hub $ver is running"
  # Keep the current release and the two before it.
  ls -1dt "$BASE"/releases/* 2>/dev/null | tail -n +4 | while read -r old; do
    [ "$old" = "$BASE/releases/$ver" ] || [ "$old" = "$prev" ] || rm -rf "$old"
  done
  exit 0
fi

echo "fossibot-hub $ver did not start in ${WAIT} s — відкат" >&2
if ! stop_hub; then
  echo "the new release does not stop; database left as is, starting the old release" >&2
  back_to_previous
  exit 1
fi
if [ -f "$DATA/hub.db.before-$ver" ]; then
  cp "$DATA/hub.db.before-$ver" "$DATA/hub.db"
  rm -f "$DATA/hub.db-wal" "$DATA/hub.db-shm"
fi
back_to_previous
if [ -n "$prev" ] && wait_for "$(cat "$prev/VERSION")"; then
  echo "fossibot-hub $(cat "$prev/VERSION") is running again" >&2
fi
exit 1
